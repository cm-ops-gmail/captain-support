# Cap10 Support — copy to .env and fill in from YOUR NEW Supabase project
# (Project Settings → API). Do not reuse the Student Support Hub project.

# Server-side
SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"   # secret — never commit

# Client-side (must match the server-side project)
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"

# Session cookie secret — generate with: openssl rand -hex 32
SESSION_SECRET="replace-with-a-random-64-char-hex-string"
